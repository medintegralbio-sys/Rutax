rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. Funciones de Ayuda (Motor de Reglas)
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && currentUser().rol == 'superadmin';
    }

    function isRole(role) {
      return isSignedIn() && currentUser().rol == role;
    }

    function isSameCoop(coopId) {
      return isSignedIn() && (currentUser().cooperativaId == coopId || isSuperAdmin());
    }

    function isCoopAdmin(coopId) {
      return isRole('admin_coop') && isSameCoop(coopId);
    }

    // -------------------------------------------------------------------------
    // 2. Reglas por Colección (Mapeadas a Rutax-Smart)
    // -------------------------------------------------------------------------

    // Cooperativas: Solo SuperAdmin crea/edita. Todos leen.
    match /cooperativas/{coopId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Usuarios: Lectura general. Escritura por el propio usuario, AdminCoop o SuperAdmin.
    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow create: if true; 
      allow update: if isSuperAdmin() || request.auth.uid == userId || isCoopAdmin(request.resource.data.cooperativaId);
      allow delete: if isSuperAdmin();
    }

    // Vehículos: Control total por Admins y Despachadores de su cooperativa.
    match /vehiculos/{vehiculoId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isCoopAdmin(request.resource.data.cooperativaId) || isRole('despachador');
    }

    // Vehículos Pendientes: Socios crean, Admins revisan.
    match /vehiculos_pendientes/{solId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isRole('admin_coop');
    }

    // Bases: Configuración de terminales.
    match /bases/{baseId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isCoopAdmin(request.resource.data.cooperativaId);
    }

    // Turnos: Gestión de cola FIFO.
    match /turnos/{turnoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSameCoop(request.resource.data.cooperativaId);
    }

    // Despachos: Historial y viajes en ruta.
    match /despachos/{despachoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSameCoop(request.resource.data.cooperativaId);
    }

    // Solicitudes Pasajero Ruta: Público crea, Choferes/Base procesan.
    match /solicitudes_pasajero_ruta/{solId} {
      allow read: if isSignedIn();
      allow create: if true; 
      allow update, delete: if isSignedIn();
    }

    // Tracking Live: Posiciones en tiempo real (Escritura por conductores).
    match /tracking_live/{vehiculoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }

    // Alertas Tracking: Seguridad preventiva.
    match /alertas_tracking/{alertaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSameCoop(request.resource.data.cooperativaId);
    }

    // Geocercas: Control perimetral.
    match /geocercas/{geocercaId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isCoopAdmin(request.resource.data.cooperativaId);
    }

    // Tracking Historial: Auditoría de ruta.
    match /tracking_historial/{histId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSameCoop(request.resource.data.cooperativaId);
    }

    // Reservas Clientes: Recogidas programadas.
    match /reservas_clientes/{resId} {
      allow read: if isSignedIn() || (request.auth == null && resource.data.cliente_telefono == request.query.telefono);
      allow create: if true; 
      allow update, delete: if isSignedIn();
    }

    // Logs Inmutables: Solo lectura y creación.
    match /logs_auditoria/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /logs_auditoria_turnos/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
